# --- Database ---
DATABASE_URL=postgres://greenlight:greenlight@localhost:5432/greenlight

# --- Storage (MinIO locally, S3/R2 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=greenlight
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- LLM (model names come from env, never hard-coded) ---
ANTHROPIC_API_KEY=
MODEL_VISION=claude-sonnet-5
MODEL_FAST=claude-haiku-4-5-20251001

# --- Auth.js ---
AUTH_SECRET=change-me
AUTH_URL=http://localhost:3000

# --- Worker ---
WORKER_POLL_INTERVAL_S=1.5
WORKER_MAX_ATTEMPTS=3
