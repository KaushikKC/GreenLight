# --- Database ---
DATABASE_URL=postgres://greenlight:greenlight@localhost:5433/greenlight

# --- Storage (MinIO locally, S3/R2 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=greenlight
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- LLM (model names come from env, never hard-coded) ---
# Provider: anthropic | gemini | replay. Leave empty to use whichever key is set
# (Anthropic first). `replay` serves saved answers from LLM_REPLAY_DIR (tests/demo).
LLM_PROVIDER=
LLM_REPLAY_DIR=

# Anthropic (paid)
ANTHROPIC_API_KEY=
MODEL_VISION=claude-sonnet-5
MODEL_FAST=claude-haiku-4-5-20251001

# Google Gemini (free tier: https://aistudio.google.com/apikey, no card).
# Free-tier data may be used by Google to improve its models: test videos only.
# The free tier allows ~20 requests/day PER MODEL, so list fallbacks (comma-separated):
# when one model's daily quota runs out, the next is used.
GEMINI_API_KEY=
GEMINI_MODEL_VISION=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_FREE_TIER=true

# --- Auth.js ---
AUTH_SECRET=change-me
AUTH_URL=http://localhost:3000

# --- Worker ---
WORKER_POLL_INTERVAL_S=1.5
WORKER_MAX_ATTEMPTS=3
